# ==========================================
# MAHI QUIZ BOT CONFIGURATION (.env)
# ==========================================

# 1. Telegram Bot Token (Get from @BotFather)
BOT_TOKEN=your_new_bot_token_here

# 2. Telegram Owner ID (Your Telegram User ID, e.g., 123456789)
OWNER_ID=your_telegram_user_id_here

# 3. Telegram Group ID (Optional - Group ID where bot operates)
GROUP_ID=0

# 4. Long Question Threshold (Default 200 characters)
LONG_QUESTION_THRESHOLD=200

# 5. MongoDB Database Connection URI (Optional)
# If left empty, quizzes will be stored locally in memory and SQLite quiz_bot.db
MONGODB_URI=

# 6. MTProto Userbot Credentials (Optional - For @QuizBot /clone feature)
# Get API_ID and API_HASH from https://my.telegram.org
TELEGRAM_API_ID=0
TELEGRAM_API_HASH=
MTPROTO_SESSION_STRING=
